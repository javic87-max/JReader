<Window x:Class="lector_de_libros.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:models="clr-namespace:lector_de_libros.Models"
        mc:Ignorable="d"
        Title="Biblioteca" Height="420" Width="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="LibraryListBox" Grid.Row="0"
                 ItemsSource="{Binding LibraryBooks}"
                 AutomationProperties.Name="Biblioteca"
                 SelectionChanged="LibraryListBox_SelectionChanged"
                 KeyDown="LibraryListBox_KeyDown"
                 MouseDoubleClick="LibraryListBox_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <!-- Explicit AutomationProperties.Name for the same reason as the TOC TreeView:
                     don't rely on WPF's automatic accessible-name inference for templated items. -->
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:LibraryBook}">
                    <TextBlock Text="{Binding Title}" Margin="2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenButton" Content="A_brir" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="OpenButton_Click"/>
            <Button Content="_Añadir libro…" MinWidth="110" Margin="0,0,8,0" Click="AddButton_Click"/>
            <Button x:Name="RemoveButton" Content="_Quitar" MinWidth="80" Margin="0,0,8,0" Click="RemoveButton_Click"/>
            <Button Content="_Cerrar" IsCancel="True" MinWidth="80" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
