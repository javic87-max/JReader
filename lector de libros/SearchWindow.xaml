<Window x:Class="lector_de_libros.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar en el libro" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <StackPanel Margin="12">
        <!-- Target + access key gives NVDA the label as the edit field's name. -->
        <Label Content="_Texto a buscar:" Target="{Binding ElementName=SearchTextBox}" Padding="0,0,0,4"/>
        <TextBox x:Name="SearchTextBox" AutomationProperties.Name="Texto a buscar"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_Buscar" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="FindButton_Click"/>
            <Button Content="_Cancelar" IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
